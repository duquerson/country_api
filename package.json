{
  "name": "country-api-hexagonal",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('pnpm')){ console.error('ERROR: Use pnpm (detected '+ua+')'); process.exit(1);} \"",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "typecheck": "astro check",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.16",
    "@astrojs/vue": "7.1.1",
    "@fontsource/nunito-sans": "5.3.0",
    "@heroicons/vue": "2.2.0",
    "astro": "7.4.1",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3"
    }
  }
}
