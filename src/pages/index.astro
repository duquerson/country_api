---
import BaseLayout from '../layouts/BaseLayout.astro';
import ListSearch from '@presentation/components/country/ListSearch.vue';
import SkeletonList from '@presentation/components/country/SkeletonList.astro';
import { getCountries } from '../core/di';
import { getFriendlyMessage } from '../core/domain/errors';
import type { CountrySummary } from '../core/domain/types';

// SSR: Carga inicial con propagación de error
let initialCountries: CountrySummary[] = [];
let initialError: string | null = null;

try {
  initialCountries = await getCountries.execute();
} catch (err) {
  // Registrar en servidor para observabilidad
  console.error('[SSR index] Error al cargar países:', err);
  initialError = getFriendlyMessage(err);
}
---

<BaseLayout 
  title="Where in the world?"
  description="Search and explore countries from around the world. Filter by region, view detailed information, and discover borders."
>
  <ListSearch
    server:defer
    client:load
    :initial-data="initialCountries"
    :initial-error="initialError"
  >
    <SkeletonList slot="fallback" />
  </ListSearch>
</BaseLayout>
